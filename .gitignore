# Secrets. .env holds live API keys and must never be committed.
# .env.example is the committed template and holds none.
.env
!.env.example

# Runtime state (§12: .agent/ is runtime state and must be gitignored)
.agent/

# Eval outputs and scratch workspace
eval/runs/
eval/workspace/*
!eval/workspace/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# A 928 MB third-party checkout kept for reference (Hermes Agent, MIT).
# The directory itself, not its contents: `hermes_copy/*` leaves the folder
# trackable, and it is only absent from `git status` today because the nested
# hermes-agent/.git makes git skip it. Delete that and 928 MB becomes
# committable.
hermes_copy/
vellum-assistant-main/
