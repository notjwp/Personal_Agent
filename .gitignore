# Secrets. .env holds live API keys and must never be committed.
# .env.example is the committed template and holds none.
.env
!.env.example

# Runtime state (§12: .agent/ is runtime state and must be gitignored)
.agent/

# Eval outputs and scratch workspace
eval/runs/
eval/workspace/*
!eval/workspace/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# A 928 MB third-party checkout kept out of the repository. The path is named
# because a .gitignore rule has no other way to name it - removing this line
# makes 928 MB committable. The directory itself, not its contents: a trailing
# `/*` would leave the folder trackable, and it is only absent from
# `git status` today because a nested .git makes git skip it.
reference_copy/